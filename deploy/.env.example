# 复制为根目录 .env 后填写：cp deploy/.env.example .env
# .env 已被 .gitignore 排除，包含数据库口令与 OAuth 密钥，绝不提交进 Git。

# ---- PostgreSQL（仅 compose 内部网络使用，不对外暴露）----
POSTGRES_DB=myblog
POSTGRES_USER=myblog
POSTGRES_PASSWORD=请改成足够长的随机密码（可运行 openssl rand -hex 24 生成）

# ---- 站点 ----
# 生产：https://hxc236.cn；本地冒烟验证：http://localhost:8088
SITE_ORIGIN=https://hxc236.cn

# ---- Admin Console（GitHub OAuth，见 docs/deploy.md §4.8）----
# 不配置时 Admin 登录入口与 MVP 内容导入不可用，公开站点其余功能不受影响
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_ADMIN_ALLOWLIST=你的GitHub登录名

# ---- JVM ----
JAVA_OPTS=-Xmx512m

# ---- Nginx 配置阶段 ----
# 证书签发前：./deploy/nginx.http.conf；签发后改为 ./deploy/nginx.conf 并重启 web
NGINX_CONF=./deploy/nginx.http.conf
