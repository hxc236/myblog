# 重要：本文件已被移出活动配置（后缀 .hide），其中的数据库密码曾提交到 Git 历史。
# 轮换责任：上线前必须重置 myblog 数据库的 root 密码（或改用最小权限账号），
# 并确认旧应用不再使用该凭据。详见 docs/deploy.md「秘密轮换」。
server.port=1816

spring.datasource.username=root
spring.datasource.password=H011235813fib!
spring.datasource.url=jdbc:mysql://localhost:3306/myblog?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jackson.date-format=yyyy-MM-dd HH:mm:ss
spring.jackson.time-zone=GMT+8
